-- Create each measure separately via Modeling > New measure.
-- Formatting: Watch Hours decimal 2; percentages format Percentage 1 decimal.
Total Titles = DISTINCTCOUNT(Content[Content_ID])
Total Movies = CALCULATE([Total Titles], Content[Type] = "Movie")
Total TV Shows = CALCULATE([Total Titles], Content[Type] = "TV Show")
Total Watch Hours = SUM(User_Engagement[Watch_Hours])
Total Sessions = SUM(User_Engagement[Sessions])
Total Engagement Events = COUNTROWS(User_Engagement)
Distinct Viewers = DISTINCTCOUNT(User_Engagement[User_ID])
Average IMDb Rating = AVERAGE(Content[IMDb_Rating])
Average Completion Rate = DIVIDE(AVERAGE(User_Engagement[Completion_Percentage]), 100)
Average Watch Hours per Event = DIVIDE([Total Watch Hours], [Total Engagement Events])
Watch Hours per Viewer = DIVIDE([Total Watch Hours], [Distinct Viewers])
Rewatch Events = CALCULATE([Total Engagement Events], User_Engagement[Rewatch_Flag] = "Yes")
Rewatch Rate = DIVIDE([Rewatch Events], [Total Engagement Events])
Thumbs Up Events = CALCULATE([Total Engagement Events], User_Engagement[Thumbs_Up] = "Yes")
Thumbs Up Rate = DIVIDE([Thumbs Up Events], [Total Engagement Events])
Netflix Original Titles = CALCULATE([Total Titles], Content[Original_Flag] = "Netflix Original")
Original Title Share = DIVIDE([Netflix Original Titles], [Total Titles])
Previous Month Watch Hours = CALCULATE([Total Watch Hours], DATEADD('Calendar'[Date], -1, MONTH))
MoM Watch Hours Change = DIVIDE([Total Watch Hours] - [Previous Month Watch Hours], [Previous Month Watch Hours])
